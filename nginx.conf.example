# ==============================================================================
# Rapid Corp — Nginx Virtual Host Configuration
# Place in /etc/nginx/sites-available/rapidcorp.in and symlink to sites-enabled/
# ==============================================================================

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name rapidcorp.in www.rapidcorp.in;
    return 301 https://rapidcorp.in$request_uri;
}

# Redirect www to non-www on HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.rapidcorp.in;

    ssl_certificate /etc/letsencrypt/live/rapidcorp.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rapidcorp.in/privkey.pem;

    return 301 https://rapidcorp.in$request_uri;
}

# Main HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rapidcorp.in;

    root /var/www/rapidcorp.in;
    index index.html;

    # SSL Certificates (e.g. Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/rapidcorp.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rapidcorp.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # SEO & Security Response Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Gzip Compression for Fast Page Speed
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml
        image/svg+xml;

    # Sitemap and Robots caching
    location ~* ^/(sitemap\.xml|robots\.txt)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
        access_log off;
    }

    # Static Assets (Images, Icons)
    location ~* \.(?:png|jpe?g|gif|ico|svg|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # HTML Documents
    location / {
        try_files $uri $uri/ /index.html =404;
        expires 1h;
        add_header Cache-Control "public, max-age=3600, must-revalidate";
    }

    # Custom 404 Error Page
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
